# Copy to .env and adjust. These are read by the backend only — none of them reach the browser.

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Storage (relative paths are resolved from the repository root)
DATA_DIR=./data
RESULTS_DIR=./results
MAX_UPLOAD_MB=25

# Chunking (identical for every K)
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=80

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
DEFAULT_TOP_K=5
RESEARCH_K_VALUES=1,3,5,10

# Local LLM (MLX on Apple Silicon). LLM_RUNTIME=none disables generation.
LLM_RUNTIME=mlx
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
LLM_MAX_TOKENS=384
LLM_TEMPERATURE=0
LLM_TOP_P=1.0
# Prompt + answer budget. Top-10 with 500-word passages needs ~8.5k tokens.
LLM_CONTEXT_TOKENS=12288
# Load the model in the background at startup
LLM_PRELOAD=true
# false = never download at runtime; run `hf download <model>` once instead
LLM_ALLOW_DOWNLOAD=false

# Frontend (frontend/.env): VITE_API_BASE_URL=http://localhost:8000
